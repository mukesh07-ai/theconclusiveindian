# The Conclusive Indian — Enterprise Microservices Configuration
# Environment: local / development

ENVIRONMENT="development"
DEBUG=true

# Security & JWT Authentication
# Generate in production: openssl rand -hex 32
JWT_SECRET_KEY="theconclusiveindian-dev-secret-key-change-in-production-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gateway Configuration
GATEWAY_PORT=8000
BACKEND_CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000","https://theconclusiveindian.in"]'

# Internal Microservice URLs (Gateway Reverse Proxy Targets)
IDENTITY_SERVICE_URL="http://localhost:8001"
USER_SERVICE_URL="http://localhost:8002"
TAXONOMY_SERVICE_URL="http://localhost:8003"
CONTENT_SERVICE_URL="http://localhost:8004"
PAGE_BUILDER_SERVICE_URL="http://localhost:8005"
MEDIA_SERVICE_URL="http://localhost:8006"
CONTACT_SERVICE_URL="http://localhost:8007"

# MySQL Server Configuration (Host or Docker)
MYSQL_HOST="127.0.0.1"
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD="MYSQLTEST"
MYSQL_USER="root"
MYSQL_PASSWORD="MYSQLTEST"
MYSQL_DATABASE="theconclusiveindian_db"

# Consolidated Single Database Architecture (MySQL 8.0 with utf8mb4 Devanagari Collation)
# Exactly ONE centralized database serves the entire website:
DATABASE_URL="mysql+aiomysql://root:MYSQLTEST@127.0.0.1:3306/theconclusiveindian_db?charset=utf8mb4"

# Media Storage Configuration
MEDIA_UPLOAD_DIR="./backend/uploads"
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES='["image/jpeg","image/png","image/webp","image/avif"]'
