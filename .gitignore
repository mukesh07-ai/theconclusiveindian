# ==========================================
# The Conclusive Indian — Root .gitignore
# ==========================================

# OS & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.pem

# IDE & Editor Files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace

# Environment Variables (keep .env.example safe)
.env
.env.*
!.env.example
*.local

# ==========================================
# Frontend (Next.js & Node)
# ==========================================
frontend/node_modules
node_modules/
node_modules
node_modules/
frontend/.next/
.next/
/public/
frontend/out/
frontend/build/
*.tsbuildinfo
next-env.d.ts
frontend/next-env.d.ts

# Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Coverage
coverage/
frontend/coverage/
.nyc_output

# ==========================================
# Backend (Python & FastAPI)
# ==========================================
backend/venv/
backend/.venv/
venv/
.venv/
env/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
*.egg-info/
dist/
build/
backend/dist/
backend/build/

# Database files
*.sqlite3
*.db

# Backend logs
backend/logs/
*.log

# Deployment artifacts
deploy.zip
*.zip
